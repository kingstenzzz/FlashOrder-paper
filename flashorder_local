#!/bin/bash
# Convenience script: run 4 FlashOrder replicas + 1 client locally.
# Assumes the project has been built (cmake + make).
#
# Usage:
#   ./flashorder_local [block-size] [fairness-param]

set -e

BLOCK_SIZE=${1:-100}
FAIRNESS=${2:-0.5}
APP="./examples/flashorder-app"
CLI="./examples/flashorder-client"
PREFIX="hotstuff.gen"

# clean up old logs
rm -f log*

# generate keys and config
./flashorder-keygen --num 4
./flashorder-tls-keygen --num 4
python3 scripts/gen_conf.py --prefix "$PREFIX" --block-size "$BLOCK_SIZE" \
    --pace-maker dummy --fairness-parameter "$FAIRNESS"

# start replicas in background
for i in 0 1 2 3; do
    "$APP" "${PREFIX}-sec${i}.conf" > "log${i}" 2>&1 &
done

echo "4 replicas started (PIDs: $(jobs -p | tr '\n' ' '))"
echo "Waiting 2 seconds for replicas to initialise..."
sleep 2

# start client
"$CLI" "${PREFIX}.conf"

# clean up
echo "Client finished. Killing replicas..."
kill $(jobs -p) 2>/dev/null || true
wait 2>/dev/null

echo "Logs saved to log0..log3"
